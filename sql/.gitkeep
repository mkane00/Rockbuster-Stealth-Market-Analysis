SQL
Customers by Country
SELECT 
    D.country,
    COUNT(DISTINCT A.customer_id) AS customer_count,
    SUM(E.amount) AS total_amount_paid
FROM customer A
INNER JOIN address B ON A.address_id = B.address_id
INNER JOIN city C ON B.city_id = C.city_id
INNER JOIN country D ON C.country_id = D.country_id
JOIN payment E ON A.customer_id = E.customer_id
GROUP BY D.country
ORDER BY customer_count DESC;


#Customer by Country and Region, + total amount paid.
SELECT 
    D.country,
    CASE 
        -- Middle East
        WHEN D.country IN ('Afghanistan','Azerbaijan','Iran','Pakistan','Turkmenistan','Bahrain',
                           'Egypt','Iraq','Israel','Kuwait','Oman','Saudi Arabia','Turkey',
                           'United Arab Emirates','Yemen') THEN 'Middle East'
        
        -- Asia
        WHEN D.country IN ('Armenia','Bangladesh','Brunei','Cambodia','China','Hong Kong','India',
                           'Indonesia','Japan','Malaysia','Myanmar','Nepal','North Korea','Philippines',
                           'South Korea','Sri Lanka','Taiwan','Thailand','Vietnam','Kazakstan') THEN 'Asia'
        
        -- Africa
        WHEN D.country IN ('Morocco','Algeria','Angola','Cameroon','Chad',
                           'Congo, The Democratic Republic of the','Ethiopia','Gambia',
                           'Kenya','Madagascar','Malawi','Mozambique','Nigeria','Runion',
                           'Senegal','South Africa','Sudan','Tanzania','Tunisia','Zambia') THEN 'Africa'

        -- Europe
        WHEN D.country IN ('Austria','Belarus','Bulgaria','Czech Republic','Estonia','Faroe Islands',
                           'Finland','France','Germany','Greece','Greenland','Holy See (Vatican City State)',
                           'Hungary','Italy','Latvia','Liechtenstein','Lithuania','Moldova','Netherlands',
                           'Poland','Romania','Slovakia','Spain','Sweden','Switzerland','Ukraine',
                           'United Kingdom','Yugoslavia') THEN 'Europe'

        -- Russia
        WHEN D.country = 'Russian Federation' THEN 'Russia'

        -- North America
        WHEN D.country IN ('American Samoa','Canada','French Polynesia','Mexico','Nauru',
                 'Saint Vincent and the Grenadines','Tonga','Tuvalu',
                           'United States','Virgin Islands, U.S.') THEN 'North America'

        -- Latin America
        WHEN D.country IN ('Anguilla','Argentina','Bolivia','Brazil','Chile','Colombia',
                           'Dominican Republic','Ecuador','French Guiana','Paraguay',
                           'Peru','Puerto Rico','Venezuela') THEN 'Latin America'

        -- Oceania
        WHEN D.country = 'New Zealand' THEN 'Oceania'

        ELSE 'Unclassified'
    END AS region,
    COUNT(DISTINCT A.customer_id) AS customer_count,
    SUM(E.amount) AS total_amount_paid
FROM customer A
INNER JOIN address B ON A.address_id = B.address_id
INNER JOIN city C ON B.city_id = C.city_id
INNER JOIN country D ON C.country_id = D.country_id
JOIN payment E ON A.customer_id = E.customer_id
GROUP BY D.country, region
ORDER BY customer_count DESC;

